###
### Возможные значения для включения параметра (любой регистр):
###   true, t, yes, y, on, 1, "<пустая строка>"
### (другие значения будут восприняты как отключение)
###

# НЕ КОММИТЬТЕ ЭТОТ КЛЮЧ В РЕПОЗИТОРИЙ
BOT_TOKEN=fake-key

# НЕ ИСПОЛЬЗУЙТЕ DEBUG МОД В ПРОДАКШЕНЕ
DEBUG=true

###
### Прокси только для Telegram (если Telegram недоступен без VPN).
### Включите в VPN-клиенте режим «системный прокси»/локальный порт
### вместо TUN-режима. Если не задан — берётся системный прокси
### (ALL_PROXY/HTTPS_PROXY). GigaChat всегда работает напрямую.
### Примеры: socks5://127.0.0.1:1080, http://127.0.0.1:2080
###
TG_PROXY=

# База данных (необязательно, по умолчанию — finfly.db в корне проекта)
# DB_URL=sqlite+aiosqlite:///finfly.db

###
### GigaChat API: https://developers.sber.ru/studio
### Ключ авторизации (Authorization key) из личного кабинета проекта
###
# НЕ КОММИТЬТЕ ЭТОТ КЛЮЧ В РЕПОЗИТОРИЙ
GIGACHAT_CREDENTIALS=fake-key
# GIGACHAT_API_PERS — физ. лица, GIGACHAT_API_B2B / GIGACHAT_API_CORP — юр. лица
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Модель должна уметь работать с изображениями (OCR-агент)
GIGACHAT_MODEL=GigaChat-2-Max
# false, если не установлен сертификат НУЦ Минцифры (только для локальных тестов)
GIGACHAT_VERIFY_SSL=false
###
### Сколько запросов к GigaChat выполнять одновременно:
###   1  — бесплатный тариф (лимит 1 поток): агенты работают по очереди
###   >1 — платный тариф: Categorize и Describer работают параллельно
###
GIGACHAT_MAX_CONCURRENCY=1
# Сколько секунд ждать ответа GigaChat (распознавание фото бывает долгим)
GIGACHAT_TIMEOUT=120
